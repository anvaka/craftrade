{
  "name": "craft-world-first-playable",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "log": "esbuild scripts/log-report.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/log-report.mjs --log-level=warning && node node_modules/.cache/log-report.mjs",
    "bot": "esbuild scripts/bot.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/bot.mjs --log-level=warning && node node_modules/.cache/bot.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
