{
  "name": "craftrade",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.2",
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@types/sql.js": "^1.4.11",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.17",
    "sql.js": "^1.16.0",
    "zod": "^4.6.7"
  }
}
